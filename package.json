{
  "name": "icvscout",
  "private": true,
  "type": "module",
  "scripts": {
    "build:lineup": "esbuild src/lineup-pitch-3d.js --bundle --minify --format=esm --target=es2020 --outfile=assets/lineup-pitch-3d.js",
    "build:home-css": "esbuild src/home.css --bundle --minify --external:/assets/* --outfile=assets/home-20261025.min.css",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build:lineup && npm run build:home-css && npm test && node --check 'functions/api/[[path]].js'",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "esbuild": "^0.28.2",
    "web-vitals": "^6.2.2"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "three": "^0.186.0"
  }
}
